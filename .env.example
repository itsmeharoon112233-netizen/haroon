# ---------------------------------------------------------------
# Xpert AI by Ghandhara Estate — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. On Vercel, add these in
# Project Settings → Environment Variables.
# ---------------------------------------------------------------

# REQUIRED — your Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# OPTIONAL — which Claude model to use (default: claude-sonnet-5-5)
# Cheaper/faster option: claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5-5

# OPTIONAL — max tokens per AI reply (default: 2048)
CLAUDE_MAX_TOKENS=2048

# OPTIONAL — where "Talk to an agent" inquiries are sent (JSON POST).
# Works with n8n, Zapier, Make, Google Apps Script, etc.
# If empty, the inquiry form tells visitors to use the contact details instead.
LEAD_WEBHOOK_URL=

# OPTIONAL — your public site URL, used for SEO / Open Graph links
NEXT_PUBLIC_SITE_URL=https://chat.ghandharaestate.com

# OPTIONAL — your existing website(s) that will show the chat via /embed.js,
# space-separated. Required for the embed to load inside another domain.
EMBED_ALLOWED_ORIGINS=https://ghandharaestate.com https://www.ghandharaestate.com
